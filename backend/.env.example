# ---------------------------------------------------------------
# TaskHub backend configuration
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------

# HTTP port the Express API listens on
PORT=5000

# Comma-separated list of allowed browser origins, or * to allow all
CORS_ORIGIN=*

# SQL Server connection
# For a named instance (e.g. SQL Express) either set DB_SERVER=localhost\SQLEXPRESS
# and leave DB_PORT empty (requires SQL Server Browser), or enable TCP/IP on a fixed port.
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Atx700wwww
DB_NAME=taskhub

# Set DB_ENCRYPT=true for Azure SQL / encrypted connections
DB_ENCRYPT=false
# Set to true for local development with self-signed certificates
DB_TRUST_SERVER_CERT=true
